    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="1 1 1" rgb2="1 1 1" markrgb="0 0 0"
      width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0"/>
    <material name="cube" rgba="0.9 0.3 0.1 1"/>
    <material name="obstacle" rgba="0.2 0.5 0.8 1"/>
  </asset>

  <default>
    <default class="cube">
      <geom type="box" size="0.05 0.05 0.05" mass="1" friction="0.6" condim="3" contype="1" conaffinity="1"
        material="cube"/>
    </default>
  </default>

